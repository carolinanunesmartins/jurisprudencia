# Copy to .env (gitignored). Only the HUMAN owner sets these; agents never see them.
# Your email, sent in the crawler User-Agent (SPEC §3). Required by `make index` / `make fetch`.
JURIS_CONTACT=
# Live LLM steps: see docs/llm-runbook.md. Make does not read this file; set them in the shell.
LLM_API_KEY=
CLASSIFY_MODEL=
JUDGE_MODEL=
# Only for an API key not scoped to a workspace (Console > Settings > Workspaces).
LLM_WORKSPACE_ID=
